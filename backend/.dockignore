# Исключение ненужных файлов и директорий из контекста сборки образа Docker для backend'а:

# Это от редактора
.idea/

# Логи
log/

# Модули
node_modules/

# Это создаётся на этапе сборки контейнера
dist/

# Это после сборки и не нужно
Dockerfile

# В продакшене тоже лишнее
README.md
LICENSE

# Примеры тоже не нужны
.env.example
